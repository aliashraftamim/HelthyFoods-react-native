{
  "expo": {
    "name": "HealthyPetuk",
    "slug": "HealthyPetuk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/screenLogo/screen-logo.png",
    "scheme": "HealthyPetuks",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aliashraf.HealthyPetuks"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-video"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbd80748-4ccb-4b9d-b658-eef48362951b"
      }
    }
  }
}
